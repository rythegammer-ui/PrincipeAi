# ─── Required in production ────────────────────────────────────────────────
# Postgres connection string (Neon / Supabase / Vercel Postgres). Without it the
# site runs in "demo mode" on an in-memory database that resets.
DATABASE_URL=
# Random 32+ char string used to sign login sessions:  openssl rand -base64 32
AUTH_SECRET=
# Your admin dashboard login (/admin)
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=
# Public URL of the site (used in emails, Stripe redirects, calendar invites)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ─── AI (Claude) ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5-5). e.g. claude-sonnet-5-5, claude-haiku-5-5
ANTHROPIC_MODEL=

# ─── Payments (Stripe) ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Email (Resend) ────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Principe AI <hello@yourdomain.com>"
CONTACT_EMAIL=principeconsults@gmail.com

# ─── Scheduling / automation ───────────────────────────────────────────────
BUSINESS_TIMEZONE=America/New_York
# Vercel Cron sends this as a Bearer token to /api/cron
CRON_SECRET=
