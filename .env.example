# ─── Required in production ────────────────────────────────────────────────
# Postgres connection string (Neon / Supabase / Vercel Postgres). A Vercel deployment
# without it refuses to start unless DEMO_MODE=1 (below).
DATABASE_URL=
# Random 32+ char string used to sign login sessions:  openssl rand -base64 32
# (at least 16 characters). Changing it signs everyone out.
AUTH_SECRET=
# Your admin dashboard login (/admin). Password: at least 12 characters, long and unique.
# Changing it signs out every admin session.
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=
# Optional: change to any new value (e.g. 2) to sign out every admin session.
ADMIN_SESSION_VERSION=
# Public URL of the site (used in emails, Stripe redirects, calendar invites)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
# Random string (openssl rand -base64 32). Vercel Cron sends it as a Bearer token to
# /api/cron. Without it every scheduled run is refused in production, so follow-up
# automation emails, booking reminders and hold/checkout cleanup never run.
CRON_SECRET=

# ─── AI (Claude) ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5-5). e.g. claude-sonnet-5-5, claude-haiku-5-5
ANTHROPIC_MODEL=
# Site-wide ceiling on AI chat + tutor replies per day (default 2000; 0 = no ceiling). Past it they use the
# built-in fallback answers until the next day. Also set a monthly spend limit in the Anthropic console.
AI_DAILY_LIMIT=

# ─── Payments (Stripe) ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Email (Resend) ────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Principe AI <hello@yourdomain.com>"
CONTACT_EMAIL=principeconsults@gmail.com

# ─── Scheduling / automation ───────────────────────────────────────────────
BUSINESS_TIMEZONE=America/New_York
# Optional: how often the cron runs, in hours (default 24 = Vercel Hobby's daily cron).
# Set 1 if you change vercel.json to an hourly schedule ("0 * * * *").
CRON_INTERVAL_HOURS=

# ─── Demo mode ─────────────────────────────────────────────────────────────
# Optional: 1 runs a Vercel deployment with no DATABASE_URL as a throwaway demo
# (in-memory data that resets; demo login admin@principe.ai / demo1234 while
# ADMIN_PASSWORD and all live Resend/Stripe/Anthropic keys are unset).
# Never use it with live payments. Leave unset in production.
DEMO_MODE=
